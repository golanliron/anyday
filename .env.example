# AnyDay - Environment Variables
# Copy this file to .env.local and fill in the values

# === Authentication (NextAuth v5) ===
AUTH_SECRET=                          # openssl rand -base64 32
AUTH_TRUST_HOST=true

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === AI ===
ANTHROPIC_API_KEY=                    # sk-ant-...

# === Monday.com OAuth ===
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=

# === Monday.com personal token (fastest way to run locally) ===
# monday.com -> avatar -> Developers -> My Access Tokens -> copy.
# This is what the app currently reads to connect to a real board.
# Scope needed: me:write  (read + write items)
MONDAY_PERSONAL_TOKEN=                # eyJhbGciOi...
#
# SAFETY: this token is shared by everyone who reaches the app, with no login.
# It is therefore IGNORED in production unless you explicitly opt in below.
# Turn it on only for a private, single-tenant deployment you control.
ANYDAY_ALLOW_PERSONAL_TOKEN=          # true | (empty)

# === Limits ===
# Max items read per board (paginated, 500 per request). Anything above this is
# reported to the user as a sample instead of being presented as the whole board.
ANYDAY_MAX_ITEMS=                     # default 2000

# === Email (Resend) ===
RESEND_API_KEY=                       # re_...

# === Database (Supabase) ===
NEXT_PUBLIC_SUPABASE_URL=             # https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # eyJ...
SUPABASE_SERVICE_ROLE_KEY=            # eyJ... (server-side only, never expose)

# === Encryption ===
ENCRYPTION_KEY=                       # 64-char hex string (32 bytes)
